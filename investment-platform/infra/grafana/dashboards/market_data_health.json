    },
    {
      "type": "stat",
      "title": "/v1 p95 latency",
      "description": "",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "api-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
