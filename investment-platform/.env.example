# Copy to .env and fill in what you need. Nothing here is required just to
# run the demo locally with SQLite -- see README "Quickest possible start".

# Database. Defaults to a local SQLite file if unset.
# For docker-compose (Postgres), this is set automatically -- see infra/docker-compose.yml.
DATABASE_URL=sqlite:///./investment_platform.db

# Required only to run the AI analyst agent (agent/chat_agent.py) and the in-app
# /chat endpoint (backend/app/services/agents/) when LLM_PROVIDER=anthropic.
# Limits on the AI chat (defaults shown). Lessons and pop-ups never call the AI.
# LLM_MAX_OUTPUT_TOKENS=600          per model call (Azure GPT-5 gets 3x for reasoning)
# LLM_MAX_TOOL_RESULT_CHARS=3000     data passed to the model per tool call (~750 tokens)
# LLM_MAX_TOOL_ROUNDS=3
# LLM_MAX_HISTORY_MESSAGES=8         earlier chat turns sent along, each cut to LLM_MAX_HISTORY_CHARS
# LLM_MAX_HISTORY_CHARS=800
# LLM_MAX_MESSAGE_CHARS=1500         longest question accepted
# LLM_DAILY_TOKEN_BUDGET=60000       per customer per day (UTC); 0 = no limit
ANTHROPIC_API_KEY=

# Which LLM backend the in-app AI analyst (/chat) uses: "anthropic", "selfhosted" or "azure".
# "selfhosted" targets an OpenAI-compatible endpoint (e.g. vLLM) via SELFHOSTED_LLM_BASE_URL --
# see create_llm_server.txt for running one on DGX1 and tunneling it to localhost.
LLM_PROVIDER=anthropic
# Use host.docker.internal instead of localhost if the backend runs via docker-compose
# (infra/docker-compose.yml) -- the tunnel to DGX1 listens on the host, not the container.
SELFHOSTED_LLM_BASE_URL=http://localhost:8001/v1
SELFHOSTED_LLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ

# Required only for pipelines/macro_ingest.py's FRED calls.
# Get a free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional -- raises CoinGecko's free-tier rate limit slightly.
COINGECKO_API_KEY=

# Optional -- required only for pipelines/prices_ingest.py's Alpha Vantage example.
ALPHA_VANTAGE_API_KEY=

# SEC requires a descriptive User-Agent with contact info on every request.
SEC_USER_AGENT=InvestmentPlatformDemo you@example.com

# CORS origins for the API, comma-separated. "*" is fine for local dev only.
CORS_ORIGINS=*

# Base URL the AI agent script uses to reach the backend.
API_BASE_URL=http://localhost:8000

# Same credentials as DATABASE_URL above, broken into discrete fields --
# only needed for the Grafana monitoring dashboard (infra/docker-compose.yml),
# whose datasource provisioning needs host/user/password separately.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Grafana admin login for the monitoring dashboard. Change this for anything
# beyond local dev.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Customer login / BFF (bff/) -------------------------------------------
# Generate the signing key pair once: cd bff && python -m scripts.generate_keys
# The BFF signs a short-lived token per API call with the private key; the API
# only accepts tokens it can verify with the public key.
API_AUTH_MODE=required
API_AUDIENCE=investment-api
# Defaults to investment-platform/secrets/bff_ed25519_public.pem -- override only if the key lives elsewhere.
# API_TRUSTED_ISSUERS=bff=/absolute/path/bff_ed25519_public.pem
# Defaults to investment-platform/secrets/bff_ed25519_private.pem.
# BFF_SIGNING_KEY_FILE=/absolute/path/bff_ed25519_private.pem
BFF_API_BASE_URL=http://localhost:8000
# Customer credentials + sessions. Separate database (or at least a separate role) recommended;
# the auth_* tables can also live in the same Postgres -- they use their own migration history.
BFF_DATABASE_URL=sqlite:///./bff.db
# Browser origins allowed to POST to the BFF (the frontend).
BFF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true behind HTTPS (cookie becomes __Host-fea_session). false only for plain-http local setups.
BFF_COOKIE_SECURE=false
BFF_SESSION_IDLE_MINUTES=30
BFF_SESSION_ABSOLUTE_HOURS=12
BFF_LOGIN_MAX_FAILURES=5
BFF_LOCKOUT_MINUTES=15
# Email: "outbox" (dev, writes .eml files to bff/outbox) or "smtp" (any provider / mail relay)
BFF_EMAIL_BACKEND=outbox
BFF_EMAIL_FROM=Investment Lab <no-reply@example.com>
BFF_PUBLIC_URL=http://localhost:5173
BFF_SMTP_HOST=
BFF_SMTP_PORT=587
BFF_SMTP_USER=
BFF_SMTP_PASSWORD=
BFF_SMTP_SECURITY=starttls
# Gmail: BFF_SMTP_HOST=smtp.gmail.com, BFF_SMTP_USER=you@gmail.com, BFF_SMTP_PASSWORD=<App password>, BFF_EMAIL_FROM=Investment Lab <you@gmail.com>
BFF_REQUIRE_EMAIL_VERIFICATION=true
# true for real customers: no API access until two-step verification is set up
BFF_REQUIRE_MFA=false
BFF_MFA_ISSUER=Investment Lab
# Shared rate limiting across BFF replicas (empty = in-memory, single instance)
BFF_REDIS_URL=

# --- MCP server for AI assistants (mcp-server/) ------------------------------
# Keys: cd bff && python -m scripts.generate_keys --name mcp  (API and BFF trust it by default)
MCP_PUBLIC_URL=http://localhost:8090
MCP_BFF_URL=http://localhost:8080
MCP_API_BASE_URL=http://localhost:8000
MCP_KEY_CACHE_S=30
MCP_CALLS_PER_MINUTE=60
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
BFF_ACCESS_KEY_MAX_DAYS=90

# --- LLM via Azure OpenAI in Azure AI Foundry (LLM_PROVIDER=azure) ----------
# AZURE_OPENAI_API_KEY empty -> Microsoft Entra ID (az login locally; managed identity or
# AZURE_CLIENT_ID/AZURE_CLIENT_SECRET/AZURE_TENANT_ID in containers).
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.2
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REASONING_EFFORT=low
