    },
    {
      "type": "timeseries",
      "title": "Run duration by job",
      "description": "",
      "id": 16,
      "datasource": {
        "type": "postgres",
        "uid": "neon-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "neon-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT started_at AS \"time\", replace(pipeline, 'market.', '') AS metric,\n  EXTRACT(EPOCH FROM (finished_at - started_at)) AS value\nFROM pipeline_runs WHERE pipeline LIKE 'market.%' AND $__timeFilter(started_at) ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Data freshness",
      "id": 17,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "panels": []
