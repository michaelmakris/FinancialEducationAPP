# Copy to .env and fill in what you need. Nothing here is required just to
# run the demo locally with SQLite -- see README "Quickest possible start".

# Database. Defaults to a local SQLite file if unset.
# For docker-compose (Postgres), this is set automatically -- see infra/docker-compose.yml.
DATABASE_URL=sqlite:///./investment_platform.db

# Required only to run the AI analyst agent (agent/chat_agent.py).
ANTHROPIC_API_KEY=

# Required only for pipelines/macro_ingest.py's FRED calls.
# Get a free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional -- raises CoinGecko's free-tier rate limit slightly.
COINGECKO_API_KEY=

# Optional -- required only for pipelines/prices_ingest.py's Alpha Vantage example.
ALPHA_VANTAGE_API_KEY=

# SEC requires a descriptive User-Agent with contact info on every request.
SEC_USER_AGENT=InvestmentPlatformDemo you@example.com

# CORS origins for the API, comma-separated. "*" is fine for local dev only.
CORS_ORIGINS=*

# Base URL the AI agent script uses to reach the backend.
API_BASE_URL=http://localhost:8000

# Same credentials as DATABASE_URL above, broken into discrete fields --
# only needed for the Grafana monitoring dashboard (infra/docker-compose.yml),
# whose datasource provisioning needs host/user/password separately.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Grafana admin login for the monitoring dashboard. Change this for anything
# beyond local dev.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
