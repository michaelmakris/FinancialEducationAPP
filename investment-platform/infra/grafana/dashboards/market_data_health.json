    {
      "type": "table",
      "title": "Last run per market job",
      "description": "",
      "id": 14,
      "datasource": {
        "type": "postgres",
        "uid": "neon-postgres"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "neon-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (pipeline)\n  replace(pipeline, 'market.', '') AS \"Job\", status AS \"Status\", started_at AS \"Last run\", rows_affected AS \"Rows\",\n  ROUND(EXTRACT(EPOCH FROM (finished_at - started_at))::numeric, 1) AS \"Duration (s)\", detail AS \"Detail\"\nFROM pipeline_runs WHERE pipeline LIKE 'market.%' ORDER BY pipeline, started_at DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "partial": {
                        "color": "orange",
                        "index": 1
                      },
                      "error": {
                        "color": "red",
                        "index": 2
                      },
                      "skipped": {
                        "color": "blue",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Hours since last successful run",
      "description": "Overdue after: crypto 7h, indicators/snapshots 26h, equities 76h, fundamentals 192h (JOB_MAX_HOURS in app/monitoring.py)",
      "id": 15,
