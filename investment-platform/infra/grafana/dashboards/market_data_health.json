    {
      "type": "table",
      "title": "Prices: newest bar per instrument",
      "description": "Stale after: crypto 1 day, equities/indices 4 days",
      "id": 18,
      "datasource": {
        "type": "postgres",
        "uid": "neon-postgres"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "neon-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT i.ticker AS \"Ticker\", i.asset_type AS \"Type\", i.data_source AS \"Source\",\n  MAX(b.date) AS \"Last bar\", CURRENT_DATE - MAX(b.date) AS \"Age (days)\", COUNT(b.id) AS \"Bars\"\nFROM instruments i LEFT JOIN price_bars b ON b.instrument_id = i.id\nWHERE i.data_source <> 'simulated'\nGROUP BY i.id, i.ticker, i.asset_type, i.data_source ORDER BY 5 DESC NULLS FIRST, 1"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age (days)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 2
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Indicators: latest snapshot",
      "description": "",
      "id": 19,
      "datasource": {
        "type": "postgres",
        "uid": "neon-postgres"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "neon-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.indicator_id AS \"Indicator\", i.name AS \"Name\", s.obs_date AS \"Latest period\",\n  s.value AS \"Value\", s.direction_90d AS \"90d\", s.staleness_d AS \"Staleness (d)\",\n  CASE WHEN s.payload_eligible THEN 'yes' ELSE 'no' END AS \"Eligible\"\nFROM indicator_snapshots s JOIN indicators i ON i.id = s.indicator_id\nWHERE s.as_of_date = (SELECT MAX(as_of_date) FROM indicator_snapshots)\nORDER BY s.payload_eligible, s.staleness_d DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Eligible"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
